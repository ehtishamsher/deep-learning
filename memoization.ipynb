   "source": [
    "# fib\n",
    "\n",
    "def fib(n,dicts):\n",
    "    if n in dicts:\n",
    "        return dicts[n]\n",
    "    else:\n",
    "        dicts[n] = fib(n-1,dicts) + fib(n-2,dicts)\n",
    "        return dicts[n]"
   ]
  },
